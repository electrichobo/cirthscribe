      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>cirth</string></array></dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>org.cirthscribe.cirth-review</string>
      <key>UTTypeDescription</key><string>Kolbítar Review Package</string>
      <key>UTTypeConformsTo</key><array><string>public.data</string></array>
      <key>UTTypeIconFile</key><string>cirth-review.icns</string>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>cirth-review</string></array></dict>
    </dict>
  </array>
</dict>
</plist>
