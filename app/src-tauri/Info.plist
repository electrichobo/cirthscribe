     and roles in step with bundle.fileAssociations in tauri.conf.json. -->
<plist version="1.0">
<dict>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Kolbítar Project</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>CFBundleTypeExtensions</key><array><string>cirth</string></array>
      <key>LSItemContentTypes</key><array><string>org.cirthscribe.cirth</string></array>
      <key>CFBundleTypeIconFile</key><string>cirth.icns</string>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>Kolbítar Review Package</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>CFBundleTypeExtensions</key><array><string>cirth-review</string></array>
      <key>LSItemContentTypes</key><array><string>org.cirthscribe.cirth-review</string></array>
      <key>CFBundleTypeIconFile</key><string>cirth-review.icns</string>
