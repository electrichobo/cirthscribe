{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kolbítar",
  "identifier": "org.cirthscribe.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Kolbítar", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"], "macOS": { "minimumSystemVersion": "11.0" } }
}
