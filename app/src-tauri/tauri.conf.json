{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kolbítar",
  "identifier": "org.cirthscribe.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Kolbítar", "width": 1400, "height": 900, "minWidth": 900, "minHeight": 560, "dragDropEnabled": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/64x64.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["cirth"],
        "name": "Kolbítar Project",
        "description": "Kolbítar Screenplay & Production Project",
        "role": "Editor"
      },
      {
        "ext": ["cirth-review"],
        "name": "Kolbítar Review Package",
        "description": "Kolbítar Portable Review Bundle",
        "role": "Viewer"
      }
    ],
    "category": "Productivity",
    "shortDescription": "Free, offline-first screenplay editor and production workspace",
    "longDescription": "Kolbítar combines screenplay editing, story planning, a shared project bible, and script-derived production tools. Free, open source, and offline first.",
    "copyright": "Kolbítar contributors",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/cirth.icns": "file-icons/cirth.icns",
        "Resources/cirth-review.icns": "file-icons/cirth-review.icns"
      },
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 432 },
        "appPosition": { "x": 160, "y": 215 },
        "applicationFolderPosition": { "x": 492, "y": 210 }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37", "libgtk-3-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
